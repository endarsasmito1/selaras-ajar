# Salin file ini jadi `.env` dan isi nilainya. Prisma tidak auto-load `.env` (lihat catatan di
# `prisma.config.ts`) — variabel di sini dipakai langsung oleh Next.js runtime.

# Wajib. Connection string PostgreSQL (Supabase). Migrasi dari SQLite per Sep 2026 — lihat
# rencana-migrasi-postgresql-selaras-ajar.md.
#
# Pakai koneksi DIRECT (port 5432, dari Project Settings → Database → Connection string di
# Supabase) untuk migration (`prisma migrate deploy`/`dev`) DAN untuk seed/runtime app selama
# masih 1 proses (PM2 tunggal). Kalau nanti app jalan lebih dari 1 instance sekaligus, pindah
# runtime ke connection string TRANSACTION POOLER (port 6543, Supavisor) dan tambahkan
# "?pgbouncer=true" di ujungnya — pooler mode transaction gak support prepared statement, dan
# Prisma perlu tahu itu buat matiin caching prepared statement-nya (kalau lupa, query bisa error
# random yang membingungkan).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres"

# WAJIB DI PRODUKSI, tanpa fallback aman. String acak panjang (mis. `openssl rand -base64 48`)
# untuk menandatangani session JWT. Kalau kosong di dev, jatuh ke fallback dev bawaan
# (src/lib/session-secret.ts) — tapi di produksi (NODE_ENV=production) app SENGAJA menolak start
# kalau var ini kosong, supaya tidak diam-diam pakai fallback yang nilainya ada di source publik.
SESSION_SECRET=""

# Opsional. API key api.co.id ("Data Sekolah Indonesia") — dipakai fitur pencarian nama sekolah
# & kode pos di form tambah sekolah superadmin (/api/superadmin/sekolah-search, -kodepos).
# Tanpa ini, fitur pencarian itu saja yang tidak berfungsi — bukan blocker untuk fitur lain.
SCHOOLS_API_KEY=""
